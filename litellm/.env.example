# LiteLLM LAN Gateway — environment template (FU-2 Phase 4)
# Copy to `.env` and fill real values. `.env` is gitignored — NEVER commit secrets.
#
# This file documents every secret/endpoint the gateway depends on. Placeholders
# only; the committed litellm-config.v2.yaml carries LAN-dev defaults for local use.
# For any non-LAN deployment, switch the config to os.environ/<VAR> substitution
# and source these vars instead (see litellm/README.md).

# --- Gateway proxy ---------------------------------------------------------
# Master key clients present as `Authorization: Bearer <key>`.
LITELLM_MASTER_KEY=sk-example-master-key
# Bind host/port (matches litellm-lan-gateway.service: 0.0.0.0:4000).
LITELLM_HOST=0.0.0.0
LITELLM_PORT=4000

# --- Ollama backends (LAN GPU nodes) --------------------------------------
OLLAMA_EVO1_BASE=http://192.168.0.72:11434
OLLAMA_EVO1_KEY=sk-example-evo1-key
OLLAMA_EVO2_BASE=http://192.168.0.15:11434
OLLAMA_EVO2_KEY=sk-example-evo2-key
OLLAMA_LEGION_BASE=http://127.0.0.1:11434
OLLAMA_LEGION_KEY=sk-example-legion-key

# --- RPC / llama.cpp OpenAI-compatible backends ---------------------------
RPC_GLM_BASE=http://192.168.0.72:8081/v1
RPC_GLM_KEY=sk-example-glm-key
RPC_Q235_BASE=http://192.168.0.15:8082/v1
RPC_Q235_KEY=sk-example-q235-key

# --- Redis cache -----------------------------------------------------------
REDIS_HOST=192.168.0.72
REDIS_PORT=6379
REDIS_NAMESPACE=banxe-litellm

# --- Optional Postgres (litellm-db; spend/key persistence) -----------------
# Only needed if you enable the `db` profile in docker-compose.yml.
POSTGRES_DB=litellm
POSTGRES_USER=litellm
POSTGRES_PASSWORD=example-db-password
POSTGRES_PORT=5435
# DATABASE_URL=postgresql://litellm:example-db-password@litellm-db:5432/litellm
