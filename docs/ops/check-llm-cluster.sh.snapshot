#!/usr/bin/env bash
# BANXE LLM Cluster Health Check
# Probes all known endpoints; appends one CSV-ish line per run to LOG.
# Idempotent, safe to run from cron under user mmber.

LOG=/var/log/llm-cluster-health.log
[ -w "$LOG" ] || LOG="$HOME/llm-cluster-health.log"

ts="$(date -Iseconds)"
declare -a results=()

probe() {
  local name="$1" url="$2" key="$3"
  local start_ns end_ns code
  start_ns=$(date +%s%N)
  if [ -n "$key" ]; then
    code=$(curl -sS -m 8 -o /dev/null -w "%{http_code}" -H "Authorization: Bearer $key" "$url" 2>/dev/null || echo "ERR")
  else
    code=$(curl -sS -m 8 -o /dev/null -w "%{http_code}" "$url" 2>/dev/null || echo "ERR")
  fi
  end_ns=$(date +%s%N)
  local ms=$(( (end_ns - start_ns) / 1000000 ))
  results+=("${name}=${code}/${ms}ms")
}

probe evo1_ollama   http://192.168.0.72:11434/api/tags   sk-banxe-evo1-local-2026
probe evo2_ollama   http://192.168.0.15:11434/api/tags   sk-banxe-evo2-local-2026
probe legion_v4000  http://127.0.0.1:4000/v1/models      sk-banxe-llm-gateway-2026
probe legion_v8080  http://127.0.0.1:8080/v1/models      ""

echo "${ts} ${results[*]}" >> "$LOG"

# BANXE_TELEGRAM_HOOK
if [ -x "$HOME/bin/banxe-telegram-notify" ]; then
  if [ -n "${LAST_FAIL_LINE:-}" ]; then
    "$HOME/bin/banxe-telegram-notify" "check-llm-cluster: $LAST_FAIL_LINE" || true
  fi
fi
